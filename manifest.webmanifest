{
  "name": "Carino Fiscal",
  "short_name": "Fiscal",
  "description": "Your tax identity, personal and business, for every jurisdiction you file in. Offline, on-device, never transmitted.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#050505",
  "theme_color": "#050505",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Check a number",
      "short_name": "Check",
      "description": "Check a tax number that is not yours, offline.",
      "url": "./?do=check",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Counter mode",
      "short_name": "Counter",
      "description": "Open your last card big enough to read out at a counter.",
      "url": "./?do=counter",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./?do=restore",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ]
}
