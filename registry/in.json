      "key": "gstin",
      "label": {
        "en": "GSTIN"
      },
      "format": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][A-Z0-9]Z[A-Z0-9]$",
      "checksum": {
        "engine": "luhn-modN",
        "base": 36
      }
    },
    {
      "key": "pan",
      "label": {
        "en": "PAN"
      },
      "format": "^[A-Z]{5}[0-9]{4}[A-Z]$",
      "checksum": {
        "engine": "structural"
      },
      "note": {
        "en": "Structure only. No published check-digit rule is implemented for this identifier yet — the badge says 'format only' rather than implying a verification that did not happen."
      }
    }
  ],
