  "identifiers": [
    {
      "key": "abn",
      "label": {
        "en": "ABN"
      },
      "format": "^[0-9]{11}$",
      "checksum": {
        "engine": "mod89"
      },
      "display": "## ### ### ###",
      "note": {
        "en": "The whole weighted sum must divide by 89 — there is no single check digit to report back, so a failure says only that the number is not a valid ABN."
      }
    }
  ],
  "invoiceProfile": {
    "personal": {
      "required": [
        "abn",
        "legalName"
      ],
      "optional": [
        "email",
        "address"
      ]
    },
    "business": {
      "required": [
        "abn",
        "legalName"
      ],
      "optional": [
        "email",
        "address"
      ]
    }
  },
  "delivery": [
